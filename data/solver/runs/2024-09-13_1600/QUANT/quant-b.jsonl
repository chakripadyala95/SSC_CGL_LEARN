{"question_id": "630680421382", "solver_id": "quant-b", "model": "sonnet", "prompt_version": "solver_v1", "answer_option": "C", "answer_value": "{30,60,90}", "method": "Angle sum 180", "steps": ["Sum must be 180", "30+60+90=180"], "check_code": "sets={'A':(30,50,90),'B':(80,50,90),'C':(30,60,90),'D':(30,50,110)}\nok=[k for k,v in sets.items() if sum(v)==180]\nassert ok==['C']\nr='{30,60,90}'\nassert r=='{30,60,90}'\nassert r!='{30,50,90}'\nassert r!='{80,50,90}'\nassert r!='{30,50,110}'\n", "confidence": 0.99}
